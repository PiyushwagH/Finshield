# Copy to backend/.env and fill in real values. Never commit backend/.env.

# Local Postgres:
#   DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/finshield
# Neon (use the pooled connection string from the Neon dashboard):
#   DATABASE_URL=postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<db>?sslmode=require
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/finshield

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Refresh-token cookie attributes. Leave unset for local dev (both defaults
# below are correct there). In production, if the frontend and backend are on
# different domains (e.g. Vercel + Render), a Lax cookie is never sent on the
# cross-site refresh request - set these two so sessions survive:
# COOKIE_SECURE=true
# COOKIE_SAMESITE=none

# Password-reset emails (POST /auth/forgot-password). If RESEND_API_KEY is
# unset, the reset link is logged instead of emailed - fine for local dev.
# Get a free key at https://resend.com (their onboarding@resend.dev sender
# works without a custom domain for testing).
# RESEND_API_KEY=

# Recommended instead of Resend: Gmail SMTP sends to ANY address with no
# domain to verify (Resend's free test sender only delivers to your own
# Resend account email). Create an App Password at
# https://myaccount.google.com/apppasswords (needs 2-Step Verification on).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=yourname@gmail.com
# SMTP_PASSWORD=<16-character app password>
# EMAIL_FROM=FinShield <onboarding@resend.dev>
# FRONTEND_URL=https://finshield-three.vercel.app

# Optional: seeds an admin account on startup if both are set.
# Must be a real domain — reserved TLDs (.local, .test, .example) are rejected.
# ADMIN_EMAIL=admin@finshield.com
# ADMIN_PASSWORD=
